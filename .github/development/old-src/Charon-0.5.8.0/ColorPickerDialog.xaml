<Window
    x:Class="Charon.ColorPickerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Charon"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Choose Color"
    Width="400"
    Height="500"
    Background="#F5F5F7"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Window.Resources>
        <!--  Modern Button Style  -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#007AFF" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Padding="16,8"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8">
                            <Border.Effect>
                                <DropShadowEffect
                                    BlurRadius="8"
                                    Opacity="0.2"
                                    ShadowDepth="2"
                                    Color="#000000" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#0051D5" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#003D99" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Secondary Button Style  -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#E5E5EA" />
            <Setter Property="Foreground" Value="#1C1C1E" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Padding="16,8"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#D1D1D6" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#C7C7CC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Modern Slider Style  -->
        <Style x:Key="ModernSlider" TargetType="Slider">
            <Setter Property="Height" Value="20" />
            <Setter Property="Foreground" Value="#007AFF" />
        </Style>

        <!--  Preset Button Style  -->
        <Style x:Key="PresetButton" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="White"
                            BorderThickness="2"
                            CornerRadius="8">
                            <Border.Effect>
                                <DropShadowEffect
                                    BlurRadius="4"
                                    Opacity="0.2"
                                    ShadowDepth="1" />
                            </Border.Effect>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect
                                            BlurRadius="8"
                                            Opacity="0.4"
                                            ShadowDepth="2" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border
        Margin="15"
        Background="White"
        CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="30"
                Opacity="0.15"
                ShadowDepth="0"
                Color="#000000" />
        </Border.Effect>
        <Grid Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Header  -->

            <!--  Red slider  -->
            <Grid Grid.Row="1" Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="45" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="#1C1C1E"
                    Text="Red" />
                <Slider
                    Name="RedSlider"
                    Grid.Column="1"
                    Margin="10,0"
                    VerticalAlignment="Center"
                    Maximum="255"
                    Minimum="0"
                    Style="{StaticResource ModernSlider}"
                    ValueChanged="ColorSlider_ValueChanged"
                    Value="255" />
                <Border
                    Grid.Column="2"
                    Padding="8,4"
                    Background="#FF3B30"
                    CornerRadius="6">
                    <TextBlock
                        Name="RedValue"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Text="255"
                        TextAlignment="Center" />
                </Border>
            </Grid>

            <!--  Green slider  -->
            <Grid Grid.Row="2" Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="45" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="#1C1C1E"
                    Text="Green" />
                <Slider
                    Name="GreenSlider"
                    Grid.Column="1"
                    Margin="10,0"
                    VerticalAlignment="Center"
                    Maximum="255"
                    Minimum="0"
                    Style="{StaticResource ModernSlider}"
                    ValueChanged="ColorSlider_ValueChanged"
                    Value="0" />
                <Border
                    Grid.Column="2"
                    Padding="8,4"
                    Background="#34C759"
                    CornerRadius="6">
                    <TextBlock
                        Name="GreenValue"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Text="0"
                        TextAlignment="Center" />
                </Border>
            </Grid>

            <!--  Blue slider  -->
            <Grid Grid.Row="3" Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="45" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="#1C1C1E"
                    Text="Blue" />
                <Slider
                    Name="BlueSlider"
                    Grid.Column="1"
                    Margin="10,0"
                    VerticalAlignment="Center"
                    Maximum="255"
                    Minimum="0"
                    Style="{StaticResource ModernSlider}"
                    ValueChanged="ColorSlider_ValueChanged"
                    Value="0" />
                <Border
                    Grid.Column="2"
                    Padding="8,4"
                    Background="#007AFF"
                    CornerRadius="6">
                    <TextBlock
                        Name="BlueValue"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Text="0"
                        TextAlignment="Center" />
                </Border>
            </Grid>

            <!--  Color preview  -->
            <Border
                Name="ColorPreview"
                Grid.Row="4"
                Height="40"
                Margin="0,5,0,20"
                Background="Red"
                CornerRadius="10">
                <Border.Effect>
                    <DropShadowEffect
                        BlurRadius="10"
                        Opacity="0.2"
                        ShadowDepth="2" />
                </Border.Effect>
            </Border>

            <!--  Preset colors  -->
            <StackPanel Grid.Row="5" Margin="0,0,0,20">
                <TextBlock
                    Margin="0,0,0,10"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="#1C1C1E"
                    Text="Preset Colors" />
                <WrapPanel Name="PresetColors" HorizontalAlignment="Center">
                    <Button
                        Background="#FF3B30"
                        Click="PresetColor_Click"
                        Style="{StaticResource PresetButton}"
                        Tag="#FF0000" />
                    <Button
                        Background="#34C759"
                        Click="PresetColor_Click"
                        Style="{StaticResource PresetButton}"
                        Tag="#00FF00" />
                    <Button
                        Background="#007AFF"
                        Click="PresetColor_Click"
                        Style="{StaticResource PresetButton}"
                        Tag="#0000FF" />
                    <Button
                        Background="#FFCC00"
                        Click="PresetColor_Click"
                        Style="{StaticResource PresetButton}"
                        Tag="#FFFF00" />
                    <Button
                        Background="#AF52DE"
                        Click="PresetColor_Click"
                        Style="{StaticResource PresetButton}"
                        Tag="#FF00FF" />
                    <Button
                        Background="#5AC8FA"
                        Click="PresetColor_Click"
                        Style="{StaticResource PresetButton}"
                        Tag="#00FFFF" />
                    <Button
                        Background="White"
                        Click="PresetColor_Click"
                        Style="{StaticResource PresetButton}"
                        Tag="#FFFFFF" />
                    <Button
                        Background="#1C1C1E"
                        Click="PresetColor_Click"
                        Style="{StaticResource PresetButton}"
                        Tag="#000000" />
                    <Button
                        Background="#FF9500"
                        Click="PresetColor_Click"
                        Style="{StaticResource PresetButton}"
                        Tag="#FFA500" />
                    <Button
                        Background="#AF52DE"
                        Click="PresetColor_Click"
                        Style="{StaticResource PresetButton}"
                        Tag="#800080" />
                </WrapPanel>
            </StackPanel>

            <!--  OK and Cancel buttons  -->
            <StackPanel
                Grid.Row="6"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <Button
                    Name="CancelButton"
                    Height="36"
                    MinWidth="90"
                    Margin="0,0,10,0"
                    Click="CancelButton_Click"
                    Content="Cancel"
                    IsCancel="True"
                    Style="{StaticResource SecondaryButton}" />
                <Button
                    Name="OkButton"
                    Height="36"
                    MinWidth="90"
                    Click="OkButton_Click"
                    Content="OK"
                    IsDefault="True"
                    Style="{StaticResource ModernButton}" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
