<Window
    x:Class="Charon.PaletteSwapper"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Charon"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Palette Swapper"
    Width="1200"
    Height="650"
    Background="SteelBlue"
    mc:Ignorable="d">
    <!--<Window.Resources>
        --><!--  Modern Button Style  --><!--
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#007AFF" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Padding="12,6"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6">
                            <Border.Effect>
                                <DropShadowEffect
                                    BlurRadius="6"
                                    Opacity="0.2"
                                    ShadowDepth="2"
                                    Color="#000000" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#0051D5" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#003D99" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#D1D1D6" />
                                <Setter Property="Foreground" Value="#8E8E93" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        --><!--  Secondary Button Style  --><!--
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#E5E5EA" />
            <Setter Property="Foreground" Value="#1C1C1E" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Padding="12,6"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#D1D1D6" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#C7C7CC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        --><!--  Modern Slider Style  --><!--
        <Style x:Key="ModernSlider" TargetType="Slider">
            <Setter Property="Height" Value="20" />
            <Setter Property="Foreground" Value="#007AFF" />
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        --><!--  Status Bar spanning all columns  -->

        <!--  Three-column layout  --><!--
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            --><!--  COLUMN 1: Original Image  --><!--
            <Border
                Grid.Column="0"
                Padding="10"
                Background="White"
                CornerRadius="10">
                <Border.Effect>
                    <DropShadowEffect
                        BlurRadius="15"
                        Opacity="0.1"
                        ShadowDepth="0"
                        Color="#000000" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    --><!--  Header  --><!--
                    <StackPanel
                        Grid.Row="0"
                        Margin="0,0,0,10"
                        Orientation="Horizontal">
                        <TextBlock
                            Width="85"
                            Margin="10,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="SteelBlue"
                            Text="Original" />
                        <Button
                            Name="LoadImageButton"
                            Height="32"
                            Background="SteelBlue"
                            Click="LoadImageButton_Click"
                            Content="Load Image"
                            Style="{StaticResource ModernButton}" />

                        <Label
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Content="From:"
                            FontSize="14"
                            Foreground="#8E8E93" />
                        <Border
                            x:Name="EyedropColor"
                            Width="24"
                            Height="24"
                            Margin="3,2,0,0"
                            Padding="10"
                            Background="White"
                            BorderBrush="CornflowerBlue"
                            BorderThickness="1"
                            CornerRadius="5" />
                    </StackPanel>

                    --><!--  Image Display  --><!--
                    <Border
                        Grid.Row="1"
                        Margin="0,0,0,0"
                        Background="Lavender"
                        BorderBrush="CornflowerBlue"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid>
                            <ScrollViewer
                                Name="OriginalScrollViewer"
                                CanContentScroll="False"
                                HorizontalScrollBarVisibility="Auto"
                                PreviewMouseWheel="OriginalScrollViewer_PreviewMouseWheel"
                                VerticalScrollBarVisibility="Auto">
                                <Image
                                    Name="OriginalImage"
                                    MaxWidth="{Binding ActualWidth, ElementName=OriginalScrollViewer}"
                                    MaxHeight="{Binding ActualHeight, ElementName=OriginalScrollViewer}"
                                    Cursor="Arrow"
                                    MouseLeftButtonDown="OriginalImage_MouseLeftButtonDown"
                                    SnapsToDevicePixels="True"
                                    Stretch="Uniform" />
                            </ScrollViewer>

                            --><!--  Zoom controls  --><!--
                            <StackPanel
                                Margin="8"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Orientation="Horizontal" />

                            --><!--  Empty state  --><!--
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock
                                    Margin="0,10,0,0"
                                    FontSize="14"
                                    Foreground="#8E8E93"
                                    Text="No image loaded" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    --><!--  Controls  --><!--
                    <StackPanel Grid.Row="2" Orientation="Vertical" />

                    --><!--  Status Bar  --><!--
                    <Border
                        Grid.Row="3"
                        Margin="0,10,0,0"
                        Padding="10,8"
                        Background="AliceBlue"
                        BorderBrush="CornflowerBlue"
                        BorderThickness="2"
                        CornerRadius="6">
                        <Border.Effect>
                            <DropShadowEffect
                                BlurRadius="10"
                                Opacity="0.08"
                                ShadowDepth="0"
                                Color="#000000" />
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Grid.Column="0"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                FontFamily="Barlow"
                                FontSize="14"
                                FontWeight="Bold"
                                Foreground="Black"
                                Text="Z" />
                            <Slider
                                x:Name="OriginalZoomSlider"
                                Width="273"
                                IsSnapToTickEnabled="False"
                                LargeChange="0.5"
                                Maximum="8"
                                Minimum="1"
                                SmallChange="0.1"
                                TickFrequency="0.25"
                                ValueChanged="OriginalZoomSlider_ValueChanged"
                                Value="1" />
                            <Button
                                Width="28"
                                Height="28"
                                Margin="10,0,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                Background="SteelBlue"
                                Click="OrigFit_Click"
                                Content="R"
                                FontSize="14"
                                FontWeight="Thin"
                                Foreground="White">
                                <Button.Resources>
                                    <Style TargetType="{x:Type Border}">
                                        <Setter Property="CornerRadius" Value="5" />
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            --><!--  Spacer  --><!--
            <Border Grid.Column="1" Background="SteelBlue" />

            --><!--  Blank middle column split into two rows  --><!--
            <Grid Grid.Column="2" Margin="0,0,0,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border
                    Grid.Row="0"
                    Margin="0,10,0,189"
                    Padding="0"
                    Background="White"
                    CornerRadius="6">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock
                            FontSize="14"
                            Foreground="#8E8E93"
                            Text="Palette Swapper" />
                    </StackPanel>
                </Border>
                <Border
                    Grid.RowSpan="2"
                    Margin="0,120,0,0"
                    Padding="10"
                    Background="White"
                    CornerRadius="6">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top">
                        <Label
                            HorizontalContentAlignment="Center"
                            Content="FROM"
                            FontSize="14"
                            Foreground="Black" />
                        <Button
                            Name="EyedropperButton"
                            Width="100"
                            Height="100"
                            Background="White"
                            BorderBrush="Black"
                            BorderThickness="2"
                            Click="EyedropperButton_Click"
                            Content="">
                            <Button.Resources>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="CornerRadius" Value="5" />
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Label
                            HorizontalContentAlignment="Center"
                            Content="TO"
                            FontSize="14"
                            Foreground="Black" />
                        <Button
                            Name="TargetColorButton"
                            Width="100"
                            Height="100"
                            Background="White"
                            BorderBrush="Black"
                            BorderThickness="2"
                            Click="ChooseColorButton_Click"
                            Content="">
                            <Button.Resources>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="CornerRadius" Value="5" />
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

            --><!--  COLUMN 2: In-Process Image  --><!--
            <Border
                Grid.Column="4"
                Padding="10"
                Background="White"
                CornerRadius="10">
                <Border.Effect>
                    <DropShadowEffect
                        BlurRadius="15"
                        Opacity="0.1"
                        ShadowDepth="0"
                        Color="#000000" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    --><!--  Header  --><!--
                    <StackPanel
                        Grid.Row="0"
                        Margin="0,0,0,10"
                        Orientation="Horizontal">
                        <TextBlock
                            Width="85"
                            Margin="10,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="DarkGoldenrod"
                            Text="In-Process" />
                        <Button
                            Name="ChooseColorButton"
                            Height="32"
                            Margin="100,0,0,0"
                            Background="DarkGoldenrod"
                            Click="ChooseColorButton_Click"
                            Content="Target Color"
                            Foreground="LightGoldenrodYellow"
                            Style="{StaticResource ModernButton}" />
                        <Label
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Content="To:"
                            FontSize="14"
                            Foreground="#8E8E93" />
                        <Border
                            x:Name="ToColor"
                            Width="24"
                            Height="24"
                            Margin="3,2,0,0"
                            Padding="10"
                            Background="White"
                            BorderBrush="DarkGoldenrod"
                            BorderThickness="1"
                            CornerRadius="5" />
                    </StackPanel>

                    --><!--  Image Display  --><!--
                    <Border
                        Grid.Row="1"
                        Background="LightGoldenrodYellow"
                        BorderBrush="DarkGoldenrod"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid>
                            <ScrollViewer
                                Name="InProcessScrollViewer"
                                CanContentScroll="False"
                                HorizontalScrollBarVisibility="Auto"
                                PreviewMouseWheel="InProcessScrollViewer_PreviewMouseWheel"
                                VerticalScrollBarVisibility="Auto">
                                <Image
                                    Name="InProcessImage"
                                    MaxWidth="{Binding ActualWidth, ElementName=InProcessScrollViewer}"
                                    MaxHeight="{Binding ActualHeight, ElementName=InProcessScrollViewer}"
                                    SnapsToDevicePixels="True"
                                    Stretch="Uniform" />
                            </ScrollViewer>

                            --><!--  Zoom controls  --><!--
                            <StackPanel
                                Margin="8"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Orientation="Horizontal">
                                <Button
                                    Width="24"
                                    Height="24"
                                    Margin="2"
                                    Click="InProcessZoomIn_Click"
                                    Content="+"
                                    FontSize="14"
                                    Style="{StaticResource SecondaryButton}"
                                    ToolTip="Zoom In" />
                                <Button
                                    Width="24"
                                    Height="24"
                                    Margin="2"
                                    Click="InProcessZoomOut_Click"
                                    Content="?"
                                    FontSize="14"
                                    Style="{StaticResource SecondaryButton}"
                                    ToolTip="Zoom Out" />
                                <Button
                                    Width="32"
                                    Height="24"
                                    Margin="2"
                                    Click="InProcessFit_Click"
                                    Content="Fit"
                                    FontSize="9"
                                    Style="{StaticResource SecondaryButton}"
                                    ToolTip="Reset to fit" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    --><!--  Controls: status bars and actions  --><!--
                    <StackPanel Grid.Row="2" Orientation="Vertical">
                        <StackPanel Orientation="Horizontal">
                            --><!--  Status Bar  --><!--
                            <Border
                                Width="172"
                                Height="47"
                                Margin="0,10,0,0"
                                Padding="10,8"
                                Background="LightGoldenrodYellow"
                                BorderBrush="DarkGoldenrod"
                                BorderThickness="2"
                                CornerRadius="6">
                                <Border.Effect>
                                    <DropShadowEffect
                                        BlurRadius="10"
                                        Opacity="0.08"
                                        ShadowDepth="0"
                                        Color="#000000" />
                                </Border.Effect>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        FontFamily="Barlow"
                                        FontSize="14"
                                        FontWeight="Bold"
                                        Foreground="Black"
                                        Text="T" />
                                    <Slider
                                        Name="ToleranceSlider"
                                        Width="89"
                                        VerticalAlignment="Center"
                                        Maximum="100"
                                        Minimum="0"
                                        Style="{StaticResource ModernSlider}"
                                        Value="30" />
                                    <Border
                                        Margin="8,0,0,0"
                                        Padding="6,2"
                                        Background="DarkGoldenrod"
                                        CornerRadius="4">
                                        <TextBlock
                                            Name="ToleranceValue"
                                            Padding="0,3,0,0"
                                            Background="DarkGoldenrod"
                                            FontSize="12"
                                            FontWeight="Regular"
                                            Foreground="LightGoldenrodYellow"
                                            Text="30%" />
                                    </Border>
                                </StackPanel>
                            </Border>

                            --><!--  Second Status Bar  --><!--
                            <Border
                                Width="172"
                                Height="47"
                                Margin="10,10,0,0"
                                Padding="10,8"
                                Background="LightGoldenrodYellow"
                                BorderBrush="DarkGoldenrod"
                                BorderThickness="2"
                                CornerRadius="6">
                                <Border.Effect>
                                    <DropShadowEffect
                                        BlurRadius="10"
                                        Opacity="0.08"
                                        ShadowDepth="0"
                                        Color="#000000" />
                                </Border.Effect>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        FontFamily="Barlow"
                                        FontSize="14"
                                        FontWeight="Bold"
                                        Foreground="Black"
                                        Text="Z" />
                                    <Slider
                                        Name="ToleranceSlider2"
                                        Width="95"
                                        VerticalAlignment="Center"
                                        Maximum="100"
                                        Minimum="0"
                                        Style="{StaticResource ModernSlider}"
                                        Value="30" />
                                    <Button
                                        Width="26"
                                        Height="26"
                                        Margin="10,0,0,0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Top"
                                        Background="DarkGoldenrod"
                                        Click="OrigFit_Click"
                                        Content="R"
                                        FontSize="14"
                                        FontWeight="Thin"
                                        Foreground="White">
                                        <Button.Resources>
                                            <Style TargetType="{x:Type Border}">
                                                <Setter Property="CornerRadius" Value="5" />
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        --><!--  Action Buttons  --><!--
                        <StackPanel Margin="0,8,0,0" Orientation="Vertical">
                            <Button
                                Name="SaveButton"
                                Height="32"
                                Margin="0,0,0,6"
                                Click="SaveButton_Click"
                                Content="Save Image"
                                IsEnabled="False"
                                Style="{StaticResource ModernButton}" />
                            <Button
                                Name="ResetAllButton"
                                Height="32"
                                Click="ResetAllButton_Click"
                                Content="Reset All"
                                Style="{StaticResource SecondaryButton}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            --><!--  Right spacer removed; In-Process will occupy the right column  --><!--
        </Grid>
    </Grid>-->
</Window>
