<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <DebugType>embedded</DebugType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Project versioning -->
    <Version>0.5.8.0</Version>
    <AssemblyVersion>0.5.8.0</AssemblyVersion>
    <FileVersion>0.5.8.0</FileVersion>
    <InformationalVersion>0.5.8.0</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="AppData\Logo\Cheron-1024x1024.png" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="AppData\Logo\Cheron-1024x1024.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
  </ItemGroup>

</Project>
