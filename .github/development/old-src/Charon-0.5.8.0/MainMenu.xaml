<Window
    x:Class="Charon.MainMenu"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Charon"
    Width="1200"
    Height="650"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen">
    <Grid>
        <Border
            Width="6"
            Height="665"
            Margin="0,0,551,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            BorderBrush="Black"
            BorderThickness="3" />
        <StackPanel
            Width="200"
            Height="125"
            Margin="654,10,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top">
            <TextBlock
                Margin="0,20,0,10"
                HorizontalAlignment="Center"
                FontFamily="Barlow"
                FontSize="32"
                FontWeight="Bold"
                Text="IMAGE" />
            <Button
                Name="OpenPaletteSwapper"
                Height="40"
                Margin="0,0,0,8"
                BorderThickness="2"
                Click="OpenPaletteSwapper_Click"
                Content="Palette Swapper"
                FontFamily="Barlow"
                FontSize="16"
                FontWeight="SemiBold">
                <Button.Resources>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="CornerRadius" Value="5" />
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
        <Image
            x:Name="CheronLogo"
            Margin="0,0,556,0"
            Source="/AppData/Logo/Cheron-1024x1024.png"
            Stretch="Fill" />
        <Label
            x:Name="lblVersion"
            Width="644"
            Height="25"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            HorizontalContentAlignment="Center"
            Content="Version 0.5.0.0"
            FontFamily="Urbanist"
            Foreground="Gray" />
    </Grid>
</Window>
